# Production environment for mocker.sapper.top
#
# Copy to `.env` and place it BESIDE compose.prod.yml (i.e. /opt/mocker/.env). Compose reads
# ${VAR} substitutions from a .env in the compose file's own directory — `env_file:` only injects
# into the container and will NOT satisfy them.
#
# Generate this file with deploy/make-env.sh rather than editing by hand: a mistyped character
# inside a connection string is tedious to find.

# --- required ---------------------------------------------------------------
# Used in DATABASE_URL. Avoid : / @ ? # — they are URL-significant and will corrupt the DSN.
POSTGRES_PASSWORD=

# Signs session cookies. Changing it logs everyone out. 32+ random bytes.
JWT_SECRET=

# --- accounts provisioned at first boot -------------------------------------
# Sign-up is closed, so these are the only way in until an admin creates more.
ADMIN_EMAIL=admin@mocker.app
ADMIN_PASSWORD=
SEED_USER_EMAIL=aswathi@gmail.com
SEED_USER_PASSWORD=
# Leave DEMO_PASSWORD empty to skip creating the public demo account entirely.
DEMO_EMAIL=demo@mocker.app
DEMO_PASSWORD=

# --- LLM (optional; without it the app still works) --------------------------
# No key: current affairs falls back to a heuristic generator, and the nightly audit,
# staged classification and "Explain this more" are unavailable. Nothing crashes.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- background jobs (all times IST) ----------------------------------------
CURRENT_AFFAIRS_ENABLED=true
CURRENT_AFFAIRS_HOUR_IST=6
CURRENT_AFFAIRS_TARGET=15
VERIFY_ENABLED=true
VERIFY_HOUR_IST=3
VERIFY_PER_NIGHT=400
STAGING_ENABLED=true
STAGING_HOUR_IST=2

# --- reminders ---------------------------------------------------------------
REMINDERS_ENABLED=true
VAPID_SUBJECT=mailto:you@example.com
# Optional Telegram channel; leave blank to hide it in the UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- admin token for cron/CLI (separate from the admin login) ----------------
# Leave blank to disable the token-authenticated admin endpoints entirely.
ADMIN_TOKEN=

# --- images (override to pin or roll back) -----------------------------------
# FRONTEND_IMAGE=ghcr.io/aravindshajan6/mocker-frontend:sha-abc1234
# BACKEND_IMAGE=ghcr.io/aravindshajan6/mocker-backend:sha-abc1234
