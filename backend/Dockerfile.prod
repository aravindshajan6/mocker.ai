# Production backend. Distinct from backend/Dockerfile (the dev one), which installs pytest and
# copies the test suite in — neither belongs in a public image.
FROM python:3.12-slim AS deps
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
# Wheels are prebuilt for every dependency here, so no compiler is needed and none is installed.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS run
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/usr/local/bin:$PATH
# curl is for the healthcheck only; nothing from the build stage reaches this image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 app
COPY --from=deps /install /usr/local
COPY backend/app ./app
# The question bank is read at startup to seed the database. 2.8 MB, and static.
COPY data/questions ./data/questions
USER app
EXPOSE 8000
# Hits the real endpoint, which touches Postgres — a container that cannot serve is not healthy.
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=4 \
  CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1
# One worker: the app runs four background asyncio schedulers, which must not be duplicated.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
