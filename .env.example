# Copy to .env and adjust. All values are optional for local development.
POSTGRES_PASSWORD=mocker
JWT_SECRET=please-change-me-to-a-long-random-string
# --- Daily current-affairs generator ---
# Provider: groq (free tier, default) | gemini | openrouter | ollama | anthropic
LLM_PROVIDER=groq
# Free Groq key from https://console.groq.com (no card needed). Leave empty for heuristic-only questions.
LLM_API_KEY=
# Optional overrides (defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.5-flash, ollama=qwen2.5:7b-instruct)
LLM_MODEL=
LLM_BASE_URL=
CURRENT_AFFAIRS_ENABLED=true
CURRENT_AFFAIRS_HOUR_IST=6
CURRENT_AFFAIRS_TARGET=15
# Nightly answer-key audit of imported questions
VERIFY_ENABLED=true
VERIFY_HOUR_IST=3
VERIFY_PER_NIGHT=400
VERIFY_MODEL=qwen/qwen3.8-27b
# --- Daily reminders ---
# Web push works with no third-party account (the server generates its own VAPID keys).
REMINDERS_ENABLED=true
PUBLIC_BASE_URL=http://localhost:3001
VAPID_SUBJECT=mailto:you@example.com
# Optional Telegram channel: create a bot with @BotFather, then set both values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Set to enable POST /api/admin/current-affairs/run (header X-Admin-Token)
ADMIN_TOKEN=
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Demo account created on startup (leave DEMO_PASSWORD empty to disable)
DEMO_EMAIL=demo@mocker.app
DEMO_PASSWORD=demo1234
